# AI Gateway (Vercel AI Gateway, OpenAI-compatible API)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Application
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Generation
GENERATED_PROJECTS_DIR=./generated/projects
STORAGE_DIR=./storage

# Validation (inspect -> install -> build)
# Optional: force a package manager (pnpm|npm|yarn). Unset = auto-detect.
PACKAGE_MANAGER=
VALIDATION_INSTALL_TIMEOUT=600
VALIDATION_BUILD_TIMEOUT=300


# Browser
PLAYWRIGHT_HEADLESS=true
